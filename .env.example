# ============================================================
# Oya Chop — environment variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Never share the values in chat or PRs.
#
# In CMD:
#   copy .env.example .env.local
# ============================================================

# ---------- Neon (Postgres) ----------
# Neon dashboard → your project → Connection string (Pooled)
DATABASE_URL=

# ---------- Clerk (auth) ----------
# Clerk dashboard → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect paths — leave as-is unless we change the routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---------- Paystack (payments, TEST mode only) ----------
# Paystack dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---------- Seed ----------
# Comma-separated Clerk user IDs that should own the seeded demo vendors.
# Example: user_abc123,user_def456
SEED_OWNER_CLERK_USER_IDS=